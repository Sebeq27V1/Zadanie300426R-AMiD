<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="TaskManager">
  <grid id="27dc6" binding="panel1" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="fa963">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="64b0a" class="javax.swing.JList" binding="taskList">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="21e7" class="javax.swing.JTextField" binding="taskInputTextField">
        <constraints border-constraint="North"/>
        <properties/>
      </component>
      <component id="acdb2" class="javax.swing.JButton" binding="deleteButton">
        <constraints border-constraint="South"/>
        <properties>
          <text value="Usuń"/>
        </properties>
      </component>
      <component id="2bf75" class="javax.swing.JLabel" binding="taskCounterLabel">
        <constraints border-constraint="East"/>
        <properties>
          <text value="Liczba Zadań: 0"/>
        </properties>
      </component>
      <component id="60b44" class="javax.swing.JButton" binding="addButton">
        <constraints border-constraint="West"/>
        <properties>
          <text value="Dodaj"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
